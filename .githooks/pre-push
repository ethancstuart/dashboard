#!/bin/sh
# Pre-push gate — pushing to main DEPLOYS (Vercel builds on push; CI is a
# report that arrives after production has the code). Fast checks only: the
# AK lesson is that a slow hook is a hook people reflexively skip.
#
# Scoped to the files being pushed, not the worktree: untracked scratch from
# parallel sessions must not block a push it isn't part of.
#
# Escape hatch (same-session security fixes only): SKIP_PREPUSH=1 git push
set -e
[ -n "$SKIP_PREPUSH" ] && { echo "pre-push: SKIPPED by SKIP_PREPUSH=1"; exit 0; }

range=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null || echo '')
if [ -n "$range" ]; then
  files=$(git diff --name-only "@{u}"...HEAD --diff-filter=d | grep -E '\.(ts|tsx|js|json|css|md)$' || true)
else
  files=$(git diff --name-only HEAD~5...HEAD --diff-filter=d | grep -E '\.(ts|tsx|js|json|css|md)$' || true)
fi

if [ -n "$files" ]; then
  echo "$files" | xargs npx prettier --check --ignore-unknown || {
    echo "push blocked: prettier — run npx prettier --write on the files above"; exit 1; }
fi
# BOTH tsconfigs. A bare `npx tsc --noEmit` covers only tsconfig.json (the
# SPA) and is blind to the entire api/ directory — which is most of the
# backend. That hole let a broken import reach main on 2026-08-28 while this
# hook reported clean: the mechanism existed, the prettier half was
# plant-tested, and the typecheck half was assumed. `npm run typecheck` runs
# tsc against tsconfig.json AND tsconfig.api.json.
npm run typecheck || { echo "push blocked: typecheck (src and/or api)"; exit 1; }

# The test suite and the four derived guards. Added 2026-08-28 after an audit
# found this hook ran ONLY prettier and typecheck, while `npm run validate`
# ran five more checks that nothing on the push path executed. Pushing to main
# DEPLOYS and GitHub Actions reports afterwards, so on the one path that ships,
# "every fix ships with a guard" was enforced by habit rather than by anything.
#
# Measured before wiring: the whole suite is 454 tests in 1.81s and the four
# guards total ~6s. The "a slow hook gets skipped" argument does not apply at
# this cost — and each of these guards exists because a real defect reached
# production past its absence.
npm run test || { echo "push blocked: tests"; exit 1; }
npm run check:llm-spend  || { echo "push blocked: check:llm-spend"; exit 1; }
npm run check:collectors || { echo "push blocked: check:collectors"; exit 1; }
npm run check:cron-auth  || { echo "push blocked: check:cron-auth"; exit 1; }
npm run check:style-attr || { echo "push blocked: check:style-attr"; exit 1; }
echo "pre-push: clean"
