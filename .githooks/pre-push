#!/bin/sh
# Pre-push gate — pushing to main DEPLOYS (Vercel builds on push; CI is a
# report that arrives after production has the code). Fast checks only: the
# AK lesson is that a slow hook is a hook people reflexively skip.
#
# Scoped to the files being pushed, not the worktree: untracked scratch from
# parallel sessions must not block a push it isn't part of.
#
# Escape hatch (same-session security fixes only): SKIP_PREPUSH=1 git push
set -e
[ -n "$SKIP_PREPUSH" ] && { echo "pre-push: SKIPPED by SKIP_PREPUSH=1"; exit 0; }

range=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null || echo '')
if [ -n "$range" ]; then
  files=$(git diff --name-only "@{u}"...HEAD --diff-filter=d | grep -E '\.(ts|tsx|js|json|css|md)$' || true)
else
  files=$(git diff --name-only HEAD~5...HEAD --diff-filter=d | grep -E '\.(ts|tsx|js|json|css|md)$' || true)
fi

if [ -n "$files" ]; then
  echo "$files" | xargs npx prettier --check --ignore-unknown || {
    echo "push blocked: prettier — run npx prettier --write on the files above"; exit 1; }
fi
# BOTH tsconfigs. A bare `npx tsc --noEmit` covers only tsconfig.json (the
# SPA) and is blind to the entire api/ directory — which is most of the
# backend. That hole let a broken import reach main on 2026-08-28 while this
# hook reported clean: the mechanism existed, the prettier half was
# plant-tested, and the typecheck half was assumed. `npm run typecheck` runs
# tsc against tsconfig.json AND tsconfig.api.json.
npm run typecheck || { echo "push blocked: typecheck (src and/or api)"; exit 1; }

# The test suite, then EVERY guard the project defines — derived from
# package.json, not listed here.
#
# Added 2026-08-28 after an audit found this hook ran ONLY prettier and
# typecheck, while `npm run validate` ran five more checks that nothing on the
# push path executed. Pushing to main DEPLOYS and GitHub Actions reports
# afterwards, so on the one path that ships, "every fix ships with a guard" was
# enforced by habit rather than by anything.
#
# THE LIST IS DERIVED, and that correction came from an independent review of
# the first version of this hook. That version named the four `check:*` scripts
# one by one — so the FIFTH guard, whenever someone wrote it, would have passed
# this hook by omission until a person remembered to edit this file. That is
# precisely the enumerate-don't-derive failure this repo has legislated against,
# committed in a change whose own message was about deriving.
#
# Now the hook asks package.json which guards exist. A new `check:*` script is
# enforced the moment it is defined, with no edit here — it fails by default
# rather than passing by omission.
#
# Measured: the whole suite is ~460 tests in 1.8s and the guards total ~6s. The
# "a slow hook gets skipped" argument does not apply at this cost, and each
# guard exists because a real defect reached production past its absence.
#
# Deliberately NOT scoped to changed files, unlike prettier above: these are
# repo-wide properties. A change to file A can break a guard about file B —
# that is the entire reason they are derived rather than local.
npm run test || { echo "push blocked: tests"; exit 1; }

CHECKS=$(node -e "const s=require('./package.json').scripts||{}; console.log(Object.keys(s).filter(function(k){return k.indexOf('check:')===0}).join(' '))" 2>/dev/null)
if [ -z "$CHECKS" ]; then
  # A hook that silently runs no guards is the false-proof failure this repo
  # already paid for once. If the list cannot be derived, refuse the push.
  echo "push blocked: could not derive check:* scripts from package.json"; exit 1
fi
for c in $CHECKS; do
  npm run "$c" || { echo "push blocked: $c"; exit 1; }
done
echo "pre-push: clean ($CHECKS)"
