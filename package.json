{
  "name": "nexuswatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "npm run typecheck && vite build && node scripts/inject-sw-manifest.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run guards",
    "perf": "ANALYZE=1 npm run build",
    "prepare": "git config core.hooksPath .githooks",
    "guards": "node scripts/run-guards.mjs",
    "check:llm-spend": "tsx scripts/check-llm-spend.ts",
    "check:collectors": "tsx scripts/check-collectors.ts",
    "check:cron-auth": "tsx scripts/check-cron-auth.ts",
    "check:style-attr": "tsx scripts/check-style-attr.ts",
    "check:client-safe-imports": "tsx scripts/check-client-safe-imports.ts",
    "check:hex-literals": "tsx scripts/check-hex-literals.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^5.6.11",
    "axe-core": "^4.11.4",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.8.3",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/browser": "^10.49.0",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.184.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "@vercel/og": "^0.11.1",
    "d3": "^7.9.0",
    "parquetjs-lite": "^0.8.7",
    "resend": "^6.10.0",
    "rss-parser": "^3.13.0",
    "satellite.js": "^5.0.0",
    "three": "^0.184.0",
    "wavesurfer.js": "^7.12.7",
    "ws": "^8.20.0"
  }
}
